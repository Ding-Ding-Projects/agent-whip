{
  "name": "agent-whip",
  "version": "0.1.0",
  "private": true,
  "description": "Crack a whip at a running AI coding agent session and it switches into a faster operating mode. A mode switch, not an interrupt.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present && npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.cjs",
    "generate:icon": "node scripts/generate-icon.mjs",
    "typecheck": "tsc -b packages/paste-frame packages/core packages/cli && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "node --test packages/*/dist/**/*.test.js && node --test --experimental-strip-types src/main/*.test.ts",
    "check:no-network": "node scripts/check-no-network.mjs",
    "check:no-payload-logging": "node scripts/check-no-payload-logging.mjs",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "check": "npm run check:no-network && npm run check:no-payload-logging && npm run check:public-hygiene && npm run check:reserved-terms && npm run check:documented-commands",
    "check:reserved-terms": "node scripts/check-reserved-terms.mjs",
    "reserved:lock": "node scripts/make-reserved-lock.mjs",
    "dist:win": "electron-builder --win squirrel --config electron-builder.yml",
    "check:documented-commands": "node scripts/check-documented-commands.mjs",
    "count-lines": "node scripts/count-lines.mjs"
  },
  "dependencies": {
    "@agent-whip/core": "0.1.0",
    "@agent-whip/delivery": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3"
  },
  "author": "agent-whip contributors",
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "electron@43.4.1": true
  }
}
