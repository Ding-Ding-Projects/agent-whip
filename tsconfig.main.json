{
  "compilerOptions": {
    // Lets a test import './redact.ts' so `node --experimental-strip-types` can run it directly,
    // while tsc still emits './redact.js'. Without this the tests only ran compiled and a plain
    // strip-types run died with ERR_MODULE_NOT_FOUND on a sibling that was right there.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"]
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/shared/**/*.ts"]
}
